index=linux sourcetype=linux_secure "Accepted password"
| rex field=_raw "Accepted password for (?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| where isnotnull(src_ip)
| eval trusted_ip=if(src_ip="127.0.0.1","yes","no")
| where trusted_ip="no"
| table _time host username src_ip trusted_ip
| sort -_time
